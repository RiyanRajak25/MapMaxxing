# --- Required ---
# Google Cloud project registered for Earth Engine (see backend/SETUP.md).
GEE_PROJECT_ID=gee-urban


# --- Optional: service account, for deployment only ---
# Leave BOTH blank to use your cached `earthengine authenticate` login instead.
# Note: Earth Engine does not accept `AIzaSy...` Cloud API keys - only OAuth.
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY=

# Frontend origin(s) allowed to call this API, comma-separated
CORS_ORIGINS=http://localhost:5173

# Default Sentinel-2 CLOUDY_PIXEL_PERCENTAGE filter used when the client doesn't override it
DEFAULT_CLOUD_THRESHOLD=20

# Hard cap on AOI size to keep requests fast and within Earth Engine compute limits
MAX_AOI_KM2=3000
